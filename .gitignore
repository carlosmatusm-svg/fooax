# dependencias (Railway las instala solo)
node_modules/

# secretos y variables de entorno
.env
.env.*

# datos de operación en local (en producción viven en PostgreSQL)
data/snapshots.json
data/movimientos.json
data/*.tmp

# respaldos rescatados del sistema anterior (datos sensibles)
rescate/backup-*/

# basura del sistema
.DS_Store
*.log
npm-debug.log*
data/*.bak
apps/*.bak

# respaldos con fecha (locales) y sesiones (tokens, sensibles)
apps/*.bak-*
apps/*.bak2-*
data/*.bak-*
data/*.bak2-*
data/*.bak3-*
data/sesiones.json
data/padron_cambios.json
data/snapshots_hist.jsonl
